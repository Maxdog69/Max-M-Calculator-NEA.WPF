<Window x:Class="Calculator.WPF.VarStoreScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Calculator.WPF"
        mc:Ignorable="d"
        Title="VarStoreScreen" Height="380" Width="429">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter new value for x:" TextAlignment="Center" VerticalAlignment="Center" Grid.ColumnSpan="2"/>
        <TextBox x:Name="varInputField" Grid.Row="1" Text="" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Width="300" FontSize="30"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" Grid.RowSpan="2" >
            <Button Content="Save" Width="50" Height="20" IsDefault="True" Margin="0,0,20,0" Click="Save_Click"/>
            <Button Content="Cancel" Width="50" Height="20" IsCancel="True"/>
        </StackPanel>


    </Grid>
</Window>
