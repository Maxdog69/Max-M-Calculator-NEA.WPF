<Window x:Class="Calculator.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpfmath="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        xmlns:local="clr-namespace:Calculator.WPF"
        xmlns:vm="clr-namespace:Calculator.WPF.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainScreenViewModel}"
        mc:Ignorable="d"
        Title="Calculator" Height="840" Width="504"
        > <!-- checking this real quick-->

    <Window.InputBindings>
        <KeyBinding Key="Backspace" Command="{Binding KeyCommand}" CommandParameter="DEL" />
        <KeyBinding Key="D0" Command="{Binding KeyCommand}" CommandParameter="0" /> 
        <KeyBinding Key="D1" Command="{Binding KeyCommand}" CommandParameter="1" /> 
        <KeyBinding Key="D2" Command="{Binding KeyCommand}" CommandParameter="2" /> 
        <KeyBinding Key="D3" Command="{Binding KeyCommand}" CommandParameter="3" /> 
        <KeyBinding Key="D4" Command="{Binding KeyCommand}" CommandParameter="4" /> 
        <KeyBinding Key="D5" Command="{Binding KeyCommand}" CommandParameter="5" /> 
        <KeyBinding Key="D6" Command="{Binding KeyCommand}" CommandParameter="6" /> 
        <KeyBinding Key="D7" Command="{Binding KeyCommand}" CommandParameter="7" /> 
        <KeyBinding Key="D8" Command="{Binding KeyCommand}" CommandParameter="8" /> 
        <KeyBinding Key="D9" Command="{Binding KeyCommand}" CommandParameter="9" /> 
        <KeyBinding Key="OemPeriod" Command="{Binding KeyCommand}" CommandParameter="." /> 
        <KeyBinding Key="Enter" Command="{Binding KeyCommand}" CommandParameter="=" /> 
        <KeyBinding Key="D6" Modifiers="Shift"  Command="{Binding KeyCommand}" CommandParameter="EXP" /> 
        <KeyBinding Key="D8" Modifiers="Shift"  Command="{Binding KeyCommand}" CommandParameter="*" /> 
        <KeyBinding Key="X" Command="{Binding KeyCommand}" CommandParameter="*" /> 
        <KeyBinding Key="OemPlus" Command="{Binding KeyCommand}" CommandParameter="+" />
        <KeyBinding Key="OemPlus" Modifiers="Shift" Command="{Binding KeyCommand}" CommandParameter="+" /> 
        <KeyBinding Key="D9" Modifiers="Shift" Command="{Binding KeyCommand}" CommandParameter="(" /> 
        <KeyBinding Key="D0" Modifiers="Shift" Command="{Binding KeyCommand}" CommandParameter=")" /> 
        <KeyBinding Key="OemMinus" Command="{Binding KeyCommand}" CommandParameter="-" /> 
        <KeyBinding Key="OemQuestion" Command="{Binding KeyCommand}" CommandParameter="FRAC" /> 
        <KeyBinding Key="Left" Command="{Binding KeyCommand}" CommandParameter="LEFT" /> 
        <KeyBinding Key="Right" Command="{Binding KeyCommand}" CommandParameter="RIGHT" /> 
        <KeyBinding Key="Up" Command="{Binding KeyCommand}" CommandParameter="GOEND" /> 
        <KeyBinding Key="Down" Command="{Binding KeyCommand}" CommandParameter="GOHOME" /> 
    </Window.InputBindings>

    <Window.Resources>
        <Style x:Key="LowerScreenButton" TargetType="Button">
            <Setter Property="Background" Value="Azure"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,-5,0,0"/>
        </Style>

        <Style x:Key="MiddleScreenButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Background" Value="AntiqueWhite"/>
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="Margin" Value="5,5,5,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,-5,0,0"/>
            
        </Style>

        <Style x:Key="BorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="Gray"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="LaTeXStyle" TargetType="wpfmath:FormulaControl">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Padding" Value="10"/>
        </Style>


    </Window.Resources>


    <Grid>

        <!-- split screen into thirds-->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="1.1*"/>
        </Grid.RowDefinitions>

        <!-- display grid -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource BorderStyle}">
                <wpfmath:FormulaControl x:Name="TopExpression" Formula="\frac{a}{b} \times 1 \frac{\vert }{\square } + \ln +\log" Style="{StaticResource LaTeXStyle}"/>
            </Border>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource BorderStyle}">
                <wpfmath:FormulaControl x:Name="MidExpression" Formula="0" Style="{StaticResource LaTeXStyle}"/>
            </Border>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource BorderStyle}">
                <wpfmath:FormulaControl x:Name="BotExpression" Formula="{Binding CurrentExpression.LaTeX}" Style="{StaticResource LaTeXStyle}"/>
                <!-- actual expression -->
            </Border>

            <wpfmath:FormulaControl x:Name="TopResult" Grid.Row="0" Grid.Column="1" Formula="12" Style="{StaticResource LaTeXStyle}" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"/>
            <wpfmath:FormulaControl x:Name="MidResult" Grid.Row="1" Grid.Column="1" Formula="12" Style="{StaticResource LaTeXStyle}" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"/>
            <wpfmath:FormulaControl x:Name="BotResult" Grid.Row="2" Grid.Column="1" Formula="{Binding CurrentExpression.ResultLaTeX}" Style="{StaticResource LaTeXStyle}" HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"/>


        </Grid>



        <!--Function button grid in mid section-->
        <Grid Grid.Row="1" Background="Transparent">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AlphaButton" Content="ALPHA" Style="{StaticResource MiddleScreenButton}" Grid.Row="0" Grid.Column="0" Click="AlphaButton_Click"/>
            <Button x:Name="FunctionListButton" Content="f(𝑥)" Style="{StaticResource MiddleScreenButton}" Grid.Row="0" Grid.Column="1" Click="FunctionListButton_Click"/>
            <Button x:Name="StoreVarButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="0" Grid.Column="2" Click="StoreVarButton_Click">
                <Image Source="/ButtonIcons/StoreVar.png"/>
            </Button>
            <Button x:Name="LEFTButton" Content="◀" Style="{StaticResource MiddleScreenButton}" Grid.Row="0" Grid.Column="3" Command="{Binding KeyCommand}" CommandParameter="LEFT"/>

            <Button x:Name="RIGHTButton" Content="▶" Style="{StaticResource MiddleScreenButton}" Grid.Row="0" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="RIGHT"/>

            <Button x:Name="SquareButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="1" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="SQR">
                <Image Source="/ButtonIcons/square.png"/>
            </Button>
            <Button x:Name="ExponentButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="1" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="EXP">
                <Image Source="/ButtonIcons/Exponent.png"/>
            </Button>
            <Button x:Name="RootButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="1" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="SQRT">
                <Image Source="/ButtonIcons/Root.png"/>
            </Button>
            <Button x:Name="LogButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="1" Grid.Column="3" Command="{Binding KeyCommand}" CommandParameter="LOG">
                <Image Source="/ButtonIcons/Log10.png"/>
            </Button>
            <Button x:Name="LnButton" Content="ln(𝑥)" Style="{StaticResource MiddleScreenButton}" Grid.Row="1" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="LN"/>

            <Button x:Name="FracButton" Style="{StaticResource MiddleScreenButton}" Grid.Row="2" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="FRAC">
                <Image Source="/ButtonIcons/TestFrac.png"/>
            </Button>
            <Button x:Name="ConvertFracButton" Content="S→D" Style="{StaticResource MiddleScreenButton}" Grid.Row="2" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="SD"/>
            <Button x:Name="SinButton" Content="sin(𝑥)" Style="{StaticResource MiddleScreenButton}" Grid.Row="2" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="SIN"/>
            <Button x:Name="CosButton" Content="cos(𝑥)" Style="{StaticResource MiddleScreenButton}" Grid.Row="2" Grid.Column="3" Command="{Binding KeyCommand}" CommandParameter="COS"/>
            <Button x:Name="TanButton" Content="tan(𝑥)" Style="{StaticResource MiddleScreenButton}" Grid.Row="2" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="TAN"/>

            <Button x:Name="OpenBracButton" Content="(" Style="{StaticResource MiddleScreenButton}" Grid.Row="3" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="("/>
            <Button x:Name="CloseBracButton" Content=")" Style="{StaticResource MiddleScreenButton}" Grid.Row="3" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter=")"/>
            <Button x:Name="PiButton" Content="π" Style="{StaticResource MiddleScreenButton}" Grid.Row="3" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="PI"/>
            <Button x:Name="eButton" Content="e" Style="{StaticResource MiddleScreenButton}" Grid.Row="3" Grid.Column="3" Command="{Binding KeyCommand}" CommandParameter="E"/>
            <Button x:Name="ANSButton" Content="ANS" Style="{StaticResource MiddleScreenButton}" Grid.Row="3" Grid.Column="4" Click="ANSButton_Click"/>


        </Grid>

        <!-- Input button grid in bottom section-->
        <Grid Grid.Row="2" Background="Transparent">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Button x:Name="Num0Button" Content="0" Style="{StaticResource LowerScreenButton}" Grid.Row="3" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="0"/>
            <Button x:Name="Num1Button" Content="1" Style="{StaticResource LowerScreenButton}" Grid.Row="2" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="1"/>
            <Button x:Name="Num2Button" Content="2" Style="{StaticResource LowerScreenButton}" Grid.Row="2" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="2"/>
            <Button x:Name="Num3Button" Content="3" Style="{StaticResource LowerScreenButton}" Grid.Row="2" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="3"/>
            <Button x:Name="Num4Button" Content="4" Style="{StaticResource LowerScreenButton}" Grid.Row="1" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="4"/>
            <Button x:Name="Num5Button" Content="5" Style="{StaticResource LowerScreenButton}" Grid.Row="1" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="5"/>
            <Button x:Name="Num6Button" Content="6" Style="{StaticResource LowerScreenButton}" Grid.Row="1" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="6"/>
            <Button x:Name="Num7Button" Content="7" Style="{StaticResource LowerScreenButton}" Grid.Row="0" Grid.Column="0" Command="{Binding KeyCommand}" CommandParameter="7"/>
            <Button x:Name="Num8Button" Content="8" Style="{StaticResource LowerScreenButton}" Grid.Row="0" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="8"/>
            <Button x:Name="Num9Button" Content="9" Style="{StaticResource LowerScreenButton}" Grid.Row="0" Grid.Column="2" Command="{Binding KeyCommand}" CommandParameter="9"/>
            <Button x:Name="DecimalPointButton" Content="." Style="{StaticResource LowerScreenButton}" Grid.Row="3" Grid.Column="1" Command="{Binding KeyCommand}" CommandParameter="."/>

            <Button x:Name="EqualsButton" Content="=" Style="{StaticResource LowerScreenButton}" Grid.Row="3" Grid.Column="5" Command="{Binding KeyCommand}" CommandParameter="="/>
            <Button x:Name="AddButton" Content="+" Style="{StaticResource LowerScreenButton}" Grid.Row="2" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="+"/>
            <Button x:Name="MinusButton" Content="-" Style="{StaticResource LowerScreenButton}" Grid.Row="2" Grid.Column="5" Command="{Binding KeyCommand}" CommandParameter="-"/>
            <Button x:Name="TimesButton" Content="×" Style="{StaticResource LowerScreenButton}" Grid.Row="1" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="*"/>
            <Button x:Name="DivideButton" Content="÷" Style="{StaticResource LowerScreenButton}" Grid.Row="1" Grid.Column="5" Command="{Binding KeyCommand}" CommandParameter="/"/>
            <Button x:Name="DelButton" Content="⌫" Style="{StaticResource LowerScreenButton}" Grid.Row="0" Grid.Column="4" Command="{Binding KeyCommand}" CommandParameter="DEL"/>
            <Button x:Name="ACButton" Content="AC" Style="{StaticResource LowerScreenButton}" Grid.Row="0" Grid.Column="5" Command="{Binding KeyCommand}" CommandParameter="AC"/>


        </Grid>

    </Grid>
</Window>
